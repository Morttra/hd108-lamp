// Copy this file to include/secrets.h (which is gitignored) and fill it in.
// Without a secrets.h the firmware still builds and runs, but starts its own
// access point instead of joining your WiFi.
#pragma once

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-wifi-password"

// Must match the --auth value in platformio.ini's upload_flags.
#define OTA_PASSWORD "changeme-ota-password"

// MQTT broker for Home Assistant (Mosquitto add-on on the HA Pi).
// Leave MQTT_HOST empty ("") to disable MQTT entirely.
#define MQTT_HOST "homeassistant.local"
#define MQTT_PORT 1883
#define MQTT_USER "hd108"
#define MQTT_PASS "changeme-mqtt-password"
